# Copia este archivo a .env (o define las variables en tu sistema). NUNCA subas .env.
# Sin ninguna variable, el backend arranca en modo local: H2 en memoria + usuarios demo.

# --- Backend (solo si usas PostgreSQL / perfil prod) ---
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://localhost:5432/fincore
# DB_USER=fincore
# DB_PASSWORD=cambia-esta-clave
# JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
# CORS_ORIGIN=http://localhost:5173

# --- Frontend (archivo frontend/.env) ---
# VITE_API_URL=http://localhost:8080/api
# VITE_DEMO_MODE=true   # Demo Mode: datos ficticios en el navegador, sin backend

# --- Infraestructura opcional (desactivada por defecto; el proyecto corre sin ella) ---
# REDIS_ENABLED=true            # rate limiting compartido entre instancias
# REDIS_HOST=localhost
# REDIS_PORT=6379
# RABBITMQ_ENABLED=true         # eventos por RabbitMQ con cola de errores (DLQ)
# RABBITMQ_HOST=localhost
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest

# --- Pasarela de pagos (opcional) ---
# Sin STRIPE_SECRET_KEY se usa un proveedor simulado. Usa SOLO claves de PRUEBA (sk_test_...).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # el que muestra "stripe listen"
